#!/bin/sh
# a stand-in for `lp` in the tests of engine::platform::print
# (tests/print.rs). it spools nothing and reaches no printer. the document
# is its last argument; beside that file it writes `lp.args` (each
# argument, one per line) and answers as lp does: "request id is
# <destination>-7 (1 file(s))". without -d it refuses as a machine with no
# default destination does. the title (-t) picks a behaviour: one holding
# "slow" writes `lp.pid` (itself) and sleeps 30 s, for the deadline to
# kill; one holding "refuse" exits 1 with what lp says of a destination it
# does not know.

dest=
title=
file=
for last; do :; done
file=$last
dir=$(dirname "$file")
printf '%s\n' "$@" > "$dir/lp.args"
while [ $# -gt 0 ]; do
    case "$1" in
    -d) dest=$2; shift 2 ;;
    -t) title=$2; shift 2 ;;
    -n | -o) shift 2 ;;
    --) shift ;;
    *) shift ;;
    esac
done

case "$title" in
*slow*)
    echo $$ > "$dir/lp.pid"
    exec sleep 30
    ;;
*refuse*)
    echo "lp: No such file or directory" >&2
    exit 1
    ;;
esac
if [ -z "$dest" ]; then
    echo "lp: Error - No default destination." >&2
    exit 1
fi
if [ ! -f "$file" ]; then
    echo "lp: Error - unable to access \"$file\" - No such file or directory" >&2
    exit 1
fi
echo "request id is $dest-7 (1 file(s))"
