# normalize line endings to lf across all platforms.
* text=auto eol=lf

# rust sources use the built-in rust diff driver.
*.rs text diff=rust

# treat binary assets as binary (no eol conversion, no diff).
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.monster binary

# keep the lockfile out of "generated" stats so it shows in diffs.
Cargo.lock linguist-generated=false
