[workspace]

[package]
name = "gitbutler-phi"
version = "0.1.0"
edition = "2024"
description = "GitButler UI ported to phi -- GPU-native, no WebView, no Tauri"

[[bin]]
name = "gitbutler-phi"
path = "src/main.rs"

[[bin]]
name = "svelte-test"
path = "src/svelte_test.rs"

[dependencies]
phi = { path = "../..", package = "phi" }
wgpu = "28"
winit = { version = "0.30", features = ["rwh_06"] }
log = "0.4"
env_logger = "0.11"
pollster = "0.4"
web-time = "1.1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
