{
  "plev_ir": 1,
  "surface": {
    "id": "review",
    "title": "Review Silence Cuts",
    "root": {
      "sem": "review.root",
      "layout": {
        "stack": {
          "axis": "vertical",
          "gap": "md"
        }
      },
      "children": [
        {
          "sem": "review.title",
          "component": "text",
          "label": "Cut the Silences"
        },
        {
          "sem": "review.video_card",
          "component": "card",
          "label": "video",
          "layout": {
            "stack": {
              "axis": "vertical",
              "gap": "sm"
            }
          },
          "children": [
            {
              "sem": "review.video_file",
              "component": "text",
              "bind": {
                "state": {
                  "text": "silences.video:file"
                }
              }
            },
            {
              "sem": "review.video_duration",
              "component": "stat",
              "label": "duration (s)",
              "bind": {
                "state": {
                  "value": "silences.video:duration"
                }
              }
            },
            {
              "sem": "review.video_original",
              "component": "image",
              "label": "original frame",
              "bind": {
                "state": {
                  "source": "silences.video:original"
                }
              }
            },
            {
              "sem": "review.video_result",
              "component": "image",
              "label": "result frame",
              "bind": {
                "state": {
                  "source": "silences.video:result"
                }
              }
            }
          ]
        },
        {
          "sem": "review.controls",
          "component": "card",
          "label": "detection settings",
          "layout": {
            "stack": {
              "axis": "vertical",
              "gap": "sm"
            }
          },
          "children": [
            {
              "sem": "review.threshold",
              "component": "slider",
              "label": "threshold (dB)",
              "bind": {
                "state": {
                  "value": "silences.threshold:value"
                },
                "actions": {
                  "set_value": {
                    "target": "silences.threshold",
                    "action": "set_value"
                  }
                }
              }
            },
            {
              "sem": "review.min_duration",
              "component": "slider",
              "label": "minimum silence (s)",
              "bind": {
                "state": {
                  "value": "silences.min_duration:value"
                },
                "actions": {
                  "set_value": {
                    "target": "silences.min_duration",
                    "action": "set_value"
                  }
                }
              }
            },
            {
              "sem": "review.detect",
              "component": "button",
              "label": "detect silences",
              "bind": {
                "actions": {
                  "activate": {
                    "target": "silences.detect",
                    "action": "detect_silence"
                  }
                }
              }
            }
          ]
        },
        {
          "sem": "review.counts_card",
          "component": "card",
          "label": "summary",
          "layout": {
            "stack": {
              "axis": "vertical",
              "gap": "sm"
            }
          },
          "children": [
            {
              "sem": "review.status_message",
              "component": "text",
              "bind": {
                "state": {
                  "text": "silences.status:message"
                }
              }
            },
            {
              "sem": "review.count_total",
              "component": "stat",
              "label": "total",
              "bind": {
                "state": {
                  "value": "silences.counts:total"
                }
              }
            },
            {
              "sem": "review.count_applied",
              "component": "stat",
              "label": "applied",
              "bind": {
                "state": {
                  "value": "silences.counts:applied"
                }
              }
            },
            {
              "sem": "review.count_rejected",
              "component": "stat",
              "label": "rejected",
              "bind": {
                "state": {
                  "value": "silences.counts:rejected"
                }
              }
            },
            {
              "sem": "review.count_pending",
              "component": "stat",
              "label": "pending",
              "bind": {
                "state": {
                  "value": "silences.counts:pending"
                }
              }
            },
            {
              "sem": "review.count_cut_secs",
              "component": "stat",
              "label": "seconds cut",
              "bind": {
                "state": {
                  "value": "silences.counts:cut_secs"
                }
              }
            }
          ]
        },
        {
          "sem": "review.apply_all",
          "component": "button",
          "label": "apply all",
          "bind": {
            "actions": {
              "activate": {
                "target": "silences.apply_all",
                "action": "apply_all"
              }
            }
          }
        },
        {
          "sem": "review.cuts_list",
          "component": "list",
          "label": "cuts",
          "layout": {
            "stack": {
              "axis": "vertical",
              "gap": "sm"
            }
          },
          "repeat": {
            "each": "silences:cuts",
            "item": {
              "sem": "review.cut_item[{item}]",
              "layout": {
                "stack": {
                  "axis": "horizontal",
                  "gap": "sm",
                  "align": "center"
                }
              },
              "children": [
                {
                  "sem": "review.cut_range[{item}]",
                  "component": "text",
                  "bind": {
                    "state": {
                      "text": "silences.cut[{item}]:range"
                    }
                  }
                },
                {
                  "sem": "review.cut_decision[{item}]",
                  "component": "badge",
                  "bind": {
                    "state": {
                      "text": "silences.cut[{item}]:decision"
                    }
                  }
                },
                {
                  "sem": "review.cut_duration[{item}]",
                  "component": "stat",
                  "label": "duration (s)",
                  "bind": {
                    "state": {
                      "value": "silences.cut[{item}]:duration"
                    }
                  }
                },
                {
                  "sem": "review.cut_frame[{item}]",
                  "component": "image",
                  "label": "silence frame",
                  "props": {
                    "control_size": "xl"
                  },
                  "bind": {
                    "state": {
                      "source": "silences.cut[{item}]:frame"
                    }
                  }
                },
                {
                  "sem": "review.cut_preview[{item}]",
                  "component": "button",
                  "label": "preview",
                  "bind": {
                    "actions": {
                      "activate": {
                        "target": "silences.cut[{item}]",
                        "action": "preview_segment"
                      }
                    }
                  }
                },
                {
                  "sem": "review.cut_apply[{item}]",
                  "component": "button",
                  "label": "apply cut",
                  "bind": {
                    "actions": {
                      "activate": {
                        "target": "silences.cut[{item}]",
                        "action": "apply_cut"
                      }
                    }
                  }
                },
                {
                  "sem": "review.cut_reject[{item}]",
                  "component": "button",
                  "label": "reject cut",
                  "bind": {
                    "actions": {
                      "activate": {
                        "target": "silences.cut[{item}]",
                        "action": "reject_cut"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
