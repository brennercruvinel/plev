{
  "nodes": [
    {
      "id": "todo",
      "role": "region",
      "label": "todo"
    },
    {
      "id": "todo.input",
      "role": "text_input",
      "label": "new todo",
      "parent": "todo",
      "state": {
        "text": {
          "kind": "text",
          "value": ""
        }
      },
      "actions": [
