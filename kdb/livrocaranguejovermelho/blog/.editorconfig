# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2
indent_style = space
trim_trailing_whitespace = false

# python follows pep 8 (4 spaces)
[*.py]
indent_style = space
indent_size = 4

# yaml forbids tabs for indentation
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# json/jsonc read better at 2 spaces
[*.{json,jsonc}]
indent_style = space
indent_size = 2
